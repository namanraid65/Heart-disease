# ============================
# Research-grade additions
# ============================

# Raw dataset files (patient privacy — never commit raw data)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json

# Processed splits (reproduced from raw + manifest)
data/processed/**/*.csv
data/processed/**/*.npy
data/processed/**/*.npz
# KEEP: preprocessors and split manifests
!data/processed/**/preprocessor.joblib
!data/split_manifest.json

# Large model checkpoint weights
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.bin

# Generated archive zips
*.zip

# Scratch / temp scripts created during audit
scratch_*.py
sklearn_check.py

# Credentials and secrets (never commit)
.env
*.key
*.pem
secrets.yaml
credentials.yaml
